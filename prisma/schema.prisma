generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  domain      String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users       User[]
  clients     Client[]
  suppliers   Supplier[]
  products    Product[]
  categories  Category[]
  warehouses  Warehouse[]
  accounts    Account[]
  orders      Order[]
  invoices    Invoice[]
  carriers    Carrier[]
  purchases   Purchase[]
  units       Unit[]

  @@map("tenants")
}

model User {
  id          String    @id @default(uuid())
  email       String
  password    String
  name        String
  role        UserRole  @default(USER)
  tenantId    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  auditLogs   AuditLog[]

  @@unique([email, tenantId])
  @@map("users")
}

enum UserRole {
  ROOT
  ADMIN
  MANAGER
  USER
  ACCOUNTANT
  SELLER
}

model Client {
  id          String   @id @default(uuid())
  document    String
  name        String
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  orders      Order[]

  @@map("clients")
}

model Supplier {
  id          String   @id @default(uuid())
  document    String
  name        String
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  purchases   Purchase[]

  @@map("suppliers")
}

model Carrier {
  id          String   @id @default(uuid())
  document    String
  name        String
  email       String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  orders      Order[]

  @@map("carriers")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  parentId    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  parent      Category? @relation("CategoryParent", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryParent")
  products    Product[]

  @@map("categories")
}

model Product {
  id          String    @id @default(uuid())
  sku         String
  name        String
  description String?
  ncm         String?
  barCode     String?
  unitPrice   Decimal   @db.Decimal(10, 2)
  costPrice   Decimal   @db.Decimal(10, 2)
  stockMin    Int       @default(0)
  stockMax    Int       @default(0)
  weight      Decimal?  @db.Decimal(10, 3)
  height      Decimal?  @db.Decimal(10, 2)
  width       Decimal?  @db.Decimal(10, 2)
  depth       Decimal?  @db.Decimal(10, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  unit        Unit      @relation(fields: [unitId], references: [id])
  unitId      String
  orderItems  OrderItem[]
  stock       Stock[]
  productTaxes ProductTax[]

  @@map("products")
}

model Unit {
  id          String   @id @default(uuid())
  code        String
  name        String
  abbreviation String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  products    Product[]

  @@unique([code, tenantId])
  @@map("units")
}

model ProductTax {
  id          String   @id @default(uuid())
  taxType     TaxType
  rate        Decimal  @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id])
  productId   String

  @@map("product_taxes")
}

enum TaxType {
  ICMS
  IPI
  PIS
  COFINS
  ISS
}

model Warehouse {
  id          String   @id @default(uuid())
  code        String
  name        String
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  stock       Stock[]

  @@map("warehouses")
}

model Stock {
  id          String   @id @default(uuid())
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String

  @@map("stocks")
}

model Account {
  id          String      @id @default(uuid())
  code        String
  name        String
  type        AccountType
  parentId    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String
  parent      Account?    @relation("AccountParent", fields: [parentId], references: [id])
  children    Account[]   @relation("AccountParent")
  movements   AccountMovement[]

  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String
  status        OrderStatus   @default(DRAFT)
  type          OrderType
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  observations  String?
  issueDate     DateTime      @default(now())
  deliveryDate  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  tenantId      String
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      String
  carrier       Carrier?      @relation(fields: [carrierId], references: [id])
  carrierId     String?
  items         OrderItem[]
  payments      Payment[]
  invoices      Invoice[]

  @@map("orders")
}

enum OrderStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderType {
  SALE
  PURCHASE
}

model OrderItem {
  id          String   @id @default(uuid())
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @db.Decimal(10, 2) @default(0)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String

  @@map("order_items")
}

model Purchase {
  id            String          @id @default(uuid())
  purchaseNumber String
  status        PurchaseStatus @default(DRAFT)
  subtotal      Decimal         @db.Decimal(12, 2)
  discount      Decimal         @db.Decimal(12, 2) @default(0)
  total         Decimal         @db.Decimal(12, 2)
  issueDate     DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  tenantId      String
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  supplierId    String

  @@map("purchases")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model Invoice {
  id            String       @id @default(uuid())
  number        String
  series        String       @default("1")
  key           String       @unique
  type          InvoiceType
  status        InvoiceStatus @default(PENDING)
  total         Decimal      @db.Decimal(12, 2)
  xmlPath       String?
  pdfPath       String?
  issueDate     DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  tenantId      String
  order         Order?       @relation(fields: [orderId], references: [id])
  orderId       String?

  @@map("invoices")
}

enum InvoiceType {
  NFE
  NFCE
  NFSE
}

enum InvoiceStatus {
  PENDING
  AUTHORIZED
  CANCELLED
}

model Payment {
  id          String        @id @default(uuid())
  type        PaymentType
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime
  paidDate    DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order       Order         @relation(fields: [orderId], references: [id])
  orderId     String

  @@map("payments")
}

enum PaymentType {
  RECEIVABLE
  PAYABLE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  TRANSFER
  BOLETO
  CHECK
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model AccountMovement {
  id          String       @id @default(uuid())
  type        MovementType
  amount      Decimal      @db.Decimal(12, 2)
  description String?
  date        DateTime     @default(now())
  document    String?
  createdAt   DateTime     @default(now())

  account     Account      @relation(fields: [accountId], references: [id])
  accountId   String

  @@map("account_movements")
}

enum MovementType {
  DEBIT
  CREDIT
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entity      String
  entityId    String
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
  userId      String?

  @@map("audit_logs")
}